# SkillCascade local environment example.
# Copy to .env.local for local frontend work or export values in the shell for scripts.
# Never put real secrets in this file.

# Frontend
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
VITE_API_URL=

# Local database/security preflight scripts
DATABASE_URL=
SUPABASE_DB_URL=
SUPABASE_POSTGRES_URL=
POSTGRES_URL=
PGHOST=
PGPORT=5432
PGDATABASE=
PGUSER=
PGPASSWORD=
PGSSLMODE=require

# Goal-library maintenance scripts
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SC_EMAIL=
SC_PASSWORD=
SKILLS_COMPACT_PATH=

# Worker/API managed secrets. Configure in the deployment platform, not in committed files.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_ACCESS_KEY_ID=
AWS_S3_SECRET_ACCESS_KEY=
AWS_S3_BUCKET=
AWS_S3_PREFIX=
AWS_S3_REGION=
AWS_REGION=us-east-1
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_SOLO_PRICE_ID=
STRIPE_SOLO_ANNUAL_PRICE_ID=
STRIPE_PRACTICE_PRICE_ID=
STRIPE_PRACTICE_ANNUAL_PRICE_ID=
STRIPE_ENTERPRISE_PRICE_ID=
STRIPE_ENTERPRISE_ANNUAL_PRICE_ID=
APP_URL=
