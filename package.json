{
  "name": "skillcascade",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "build:goal-artifacts": "node scripts/build-goal-library-artifacts.mjs",
    "dev": "npm run build:goal-artifacts && vite",
    "build": "npm run build:goal-artifacts && node scripts/clean-build-dir.mjs dist && vite build",
    "build:e2e": "npm run build:goal-artifacts && node scripts/clean-build-dir.mjs dist-e2e && vite build --outDir dist-e2e",
    "preflight:rls": "node scripts/rls-security-preflight.mjs",
    "migrate:rls": "node scripts/rls-security-preflight.mjs --apply",
    "preflight:clinical-evidence": "node scripts/clinical-evidence-preflight.mjs",
    "migrate:clinical-evidence": "node scripts/clinical-evidence-preflight.mjs --apply",
    "preflight:product-workflow": "node scripts/product-workflow-preflight.mjs",
    "migrate:product-workflow": "node scripts/product-workflow-preflight.mjs --apply",
    "preflight:productization": "node scripts/productization-guardrails.mjs",
    "preview": "vite preview",
    "preview:e2e": "vite preview --outDir dist-e2e",
    "test": "npm run build:goal-artifacts && vitest",
    "test:run": "npm run build:goal-artifacts && vitest run",
    "e2e": "playwright test",
    "e2e:headed": "playwright test --headed",
    "e2e:public": "playwright test tests/e2e/public-smoke.spec.js",
    "e2e:clinical": "playwright test tests/e2e/clinical-smoke.spec.js",
    "e2e:clinical-evidence": "playwright test tests/e2e/clinical-evidence-smoke.spec.js",
    "e2e:install": "playwright install chromium"
  },
  "dependencies": {
    "@react-three/drei": "^10.7.7",
    "@react-three/fiber": "^9.5.0",
    "@react-three/postprocessing": "^3.0.4",
    "@supabase/supabase-js": "^2.97.0",
    "d3": "^7.9.0",
    "framer-motion": "^11.15.0",
    "jszip": "^3.10.1",
    "pdfjs-dist": "^4.9.155",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router-dom": "^7.1.0",
    "recharts": "^2.15.0",
    "three": "^0.183.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.2",
    "@tailwindcss/vite": "^4.0.0",
    "@vitejs/plugin-react": "^4.3.0",
    "aws4fetch": "^1.0.20",
    "jsdom": "^28.1.0",
    "pg": "^8.20.0",
    "tailwindcss": "^4.0.0",
    "vite": "^6.1.0",
    "vitest": "^4.0.18"
  }
}
